[Unit]
Description=LIM-40 weekly upstream reconciliation watch
Documentation=file:///srv/work/lhc-console/docs/UPSTREAM_OWNER.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/work/lhc-console
ExecStart=/usr/bin/python3 /srv/work/lhc-console/scripts/upstream-watch/upstream_watch.py --check-kind weekly_reconcile --write-reports --update-state
SuccessExitStatus=2
Nice=10

[Install]
WantedBy=default.target
